# App
APP_NAME="BarangGabay"
APP_URL=http://localhost/BarangGabay
APP_ENV=development
APP_DEBUG=true
APP_TIMEZONE=Asia/Manila

# Database
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=baranggabay
DB_USER=root
DB_PASS=

# AI (text only — Anthropic has no text-to-speech API)
ANTHROPIC_API_KEY=sk-ant-...

# Voice reader / text-to-speech
# Leave TTS_PROVIDER empty to use the device's own speech engine only.
#   google → Cloud Text-to-Speech, 1,000,000 free Neural2/WaveNet chars/month
#   azure  → Azure AI Speech,        500,000 free neural chars/month
# Optional: contact email sent to MyMemory (free machine translation for
# English/Filipino and the Bisaya fallback). Raises the free daily quota
# from about 5,000 to about 50,000 characters.
MYMEMORY_EMAIL=

TTS_PROVIDER=
TTS_API_KEY=
# Azure only — must match the region of the Speech resource
TTS_REGION=southeastasia
# Optional voice overrides. There is no Manobo voice anywhere; Manobo is read
# by the Filipino voice and labelled as an AI approximation.
TTS_VOICE_FIL=fil-PH-Wavenet-A
TTS_VOICE_EN=en-US-Neural2-F
TTS_SPEAKING_RATE=0.95

# Mail
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=baranggabay@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_FROM_ADDRESS=no-reply@baranggabay.ph
MAIL_FROM_NAME="BarangGabay - Barangay Bayogo"

# Google Maps
GOOGLE_MAPS_API_KEY=AIza...

# JWT
JWT_SECRET=your-very-long-random-secret-here
JWT_EXPIRY=3600

# OneWaySMS Philippines Gateway Configuration
ONEWAYSMS_USERNAME=
ONEWAYSMS_PASSWORD=
ONEWAYSMS_SENDER_ID=BARANGGABAY
ONEWAYSMS_API_URL=https://www.onewaysms.ph/api.aspx
# PayPal Checkout Integration (Orders API v2)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_MODE=sandbox

# PayMongo Payment Gateway (Primary — processes GCash, Card, QR PH)
# Get your keys from https://dashboard.paymongo.com/developers
# sk_test_... for sandbox, sk_live_... for production
PAYMONGO_SECRET_KEY=
PAYMONGO_PUBLIC_KEY=
# Webhook secret (whsk_...) — created in PayMongo Dashboard → Webhooks
PAYMONGO_WEBHOOK_SECRET=

# Optional: "Continue with Google / Facebook" for residents. Leave empty to
# hide the buttons. Redirect URIs to register with the provider:
#   <APP_URL>/auth/google/callback   and   <APP_URL>/auth/facebook/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
